{
  "name": "sqlitevis",
  "version": "0.1.0",
  "description": "SQLite B-Tree visualization with WebAssembly",
  "main": "src/web/index.html",
  "scripts": {
    "serve": "python3 -m http.server 8000 --directory .",
    "build": "make build-wasm",
    "clean": "make clean",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "install:playwright": "playwright install"
  },
  "keywords": [
    "sqlite",
    "webassembly",
    "visualization",
    "btree",
    "database"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
